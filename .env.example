# ==============================================================================
#                      PocketPay Environment Configuration
# ==============================================================================

# Flask Server Settings
FLASK_APP=run.py
FLASK_ENV=production
HOST=0.0.0.0
PORT=5000
SECRET_KEY=your-production-secret-key-32-chars-minimum

# Database Configuration (PostgreSQL on Render / SQLite locally)
DATABASE_URL=your-render-postgresql-url
# Example Local SQLite: sqlite:///pocketpay.db
# Example PostgreSQL: postgresql://user:password@hostname:5432/pocketpay_db

# Application Public URL (Used for email links & webhook callbacks)
APP_BASE_URL=https://your-app-name.onrender.com

# Transactional Email Delivery (Recommended for Cloud/Render: Resend, Brevo, SendGrid, Mailgun)
# Set EMAIL_PROVIDER=auto, resend, brevo, sendgrid, mailgun, or smtp
EMAIL_PROVIDER=auto
RESEND_API_KEY=your-resend-api-key
BREVO_API_KEY=your-brevo-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=your-mailgun-domain

# Legacy SMTP Configuration (Fallback / Local Development)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=PocketPay <noreply@pocketpay.app>

# Security & Admin Access (Only this email address is granted Admin Panel privileges)
POCKETPAY_ADMIN_EMAIL=your-admin-email@gmail.com
ADMIN_PASSWORD=your-initial-admin-seed-password
OTP_EXPIRY_MINUTES=5
PIN_ATTEMPTS_LIMIT=5
PIN_LOCKOUT_MINUTES=15

# Telegram Bot API Configuration (Optional: Get token from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-app-name.onrender.com/telegram/webhook

# Payout Service Simulation Configuration
PAYOUT_PROVIDER=sandbox
PAYOUT_SANDBOX_MODE=true

# PocketPay AI Assistant (OpenAI API Integration)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
