# ==============================================================================
#                      PocketPay Environment Configuration
# ==============================================================================

# Flask Server Settings
FLASK_APP=run.py
FLASK_ENV=development
HOST=0.0.0.0
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database Configuration (SQLite default; can use PostgreSQL/MySQL in production)
DATABASE_URL=sqlite:///pocketpay.db
# DATABASE_URL=postgresql://user:password@localhost:5432/pocketpay

# SMTP / Email OTP Configuration (Gmail, SendGrid, Mailgun, Amazon SES, etc.)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
# For Gmail, generate an App Password from your Google Account security settings
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=PocketPay <noreply@pocketpay.app>

# Security & Admin Access (Only this email has Admin Panel privileges)
POCKETPAY_ADMIN_EMAIL=akshendra.dwivedi1@gmail.com
OTP_EXPIRY_MINUTES=5
PIN_ATTEMPTS_LIMIT=5
PIN_LOCKOUT_MINUTES=15

# Telegram Bot API Configuration (Get your token from @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
