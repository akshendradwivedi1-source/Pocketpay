# ==============================================================================
#                     PocketPay Git Ignore Specification
# ==============================================================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Binaries & Executables
cloudflared.exe
*.exe
*.dll
*.dylib

# Local Databases & Instance Storage (Contains User Data)
instance/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs & Temporary Scratch Files
*.log
logs/
scratch/
tmp/
temp/
.system_generated/

# IDE & Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.cursor/
.gemini/

# Archives & Packages
*.zip
*.tar.gz
*.rar
*.7z

# Android & Gradle Build Artifacts
tools/
.gradle/
android/.gradle/
android/app/build/
android/build/
android/captures/
android/local.properties
android/Generated/
*.apk
*.aab
